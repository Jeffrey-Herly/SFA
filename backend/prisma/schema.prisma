generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  sales_rep
  sales_manager
  admin
  executive
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  dead
}

enum LeadSource {
  web_form
  manual
  referral
  import
}

enum OpportunityStage {
  prospecting
  qualification
  proposal
  negotiation
  closed_won
  closed_lost
}

enum ActivityType {
  call
  email
  meeting
  note
  status_change
}

enum OrderStatus {
  draft
  submitted
  approved
  processing
  delivered
  cancelled
}

enum TargetPeriod {
  monthly
  quarterly
  yearly
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar
  email              String   @unique @db.VarChar
  password           String   @db.VarChar
  role               Role
  is_verified        Boolean  @default(false)
  verification_token String?  @db.VarChar
  created_at         DateTime @default(now()) @db.Timestamp(6)

  // Relations
  created_leads  Lead[]     @relation("LeadCreator")
  assigned_leads Lead[]     @relation("LeadAssignee")
  activities     Activity[]
  targets        Target[]
  orders         Order[]

  @@map("users")
}

model Lead {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar
  email       String?    @db.VarChar
  phone       String?    @db.VarChar
  interest    String?
  status      LeadStatus @default(new)
  source      LeadSource @default(manual)
  created_by  String?    @db.Uuid
  assigned_to String     @db.Uuid
  notes       String?
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @updatedAt @db.Timestamp(6)

  // Relations
  creator       User?         @relation("LeadCreator", fields: [created_by], references: [id])
  assignee      User          @relation("LeadAssignee", fields: [assigned_to], references: [id])
  opportunities Opportunity[]
  activities    Activity[]

  @@map("leads")
}

model Opportunity {
  id             String           @id @default(uuid()) @db.Uuid
  title          String           @db.VarChar
  lead_id        String           @db.Uuid
  account_id     String           @db.Uuid
  stage          OpportunityStage @default(prospecting)
  amount         Decimal          @db.Decimal(15, 2)
  probability    Int              @default(0) // 0-100
  expected_close DateTime         @db.Date
  loss_reason    String?
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  updated_at     DateTime         @updatedAt @db.Timestamp(6)

  // Relations
  lead       Lead       @relation(fields: [lead_id], references: [id])
  account    Account    @relation(fields: [account_id], references: [id])
  activities Activity[]
  orders     Order[]

  @@map("opportunities")
}

model Account {
  id           String   @id @default(uuid()) @db.Uuid
  company_name String   @db.VarChar
  industry     String?  @db.VarChar
  website      String?  @db.VarChar
  address      String?
  created_at   DateTime @default(now()) @db.Timestamp(6)

  // Relations
  contacts      Contact[]
  opportunities Opportunity[]
  orders        Order[]
  activities    Activity[]

  @@map("accounts")
}

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  account_id String   @db.Uuid
  name       String   @db.VarChar
  email      String?  @db.VarChar
  phone      String?  @db.VarChar
  position   String?  @db.VarChar
  created_at DateTime @default(now()) @db.Timestamp(6)

  // Relations
  account    Account    @relation(fields: [account_id], references: [id])
  activities Activity[]

  @@map("contacts")
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  user_id        String       @db.Uuid
  lead_id        String?      @db.Uuid
  opportunity_id String?      @db.Uuid
  contact_id     String?      @db.Uuid
  account_id     String?      @db.Uuid
  type           ActivityType
  notes          String?
  meta           Json?
  activity_date  DateTime     @default(now()) @db.Timestamp(6)
  created_at     DateTime     @default(now()) @db.Timestamp(6)

  // Relations
  user        User         @relation(fields: [user_id], references: [id])
  lead        Lead?        @relation(fields: [lead_id], references: [id])
  opportunity Opportunity? @relation(fields: [opportunity_id], references: [id])
  contact     Contact?     @relation(fields: [contact_id], references: [id])
  account     Account?     @relation(fields: [account_id], references: [id])

  @@map("activities")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  order_number   String      @unique @db.VarChar
  account_id     String      @db.Uuid
  opportunity_id String?     @db.Uuid
  salesperson_id String      @db.Uuid
  status         OrderStatus @default(draft)
  order_date     DateTime    @db.Date
  delivery_date  DateTime?   @db.Date
  total_amount   Decimal     @db.Decimal(15, 2)
  notes          String?
  created_at     DateTime    @default(now()) @db.Timestamp(6)
  updated_at     DateTime    @updatedAt @db.Timestamp(6)

  // Relations
  account     Account      @relation(fields: [account_id], references: [id])
  opportunity Opportunity? @relation(fields: [opportunity_id], references: [id])
  salesperson User         @relation(fields: [salesperson_id], references: [id])
  items       OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  order_id     String   @db.Uuid
  product_name String   @db.VarChar
  quantity     Int
  unit_price   Decimal  @db.Decimal(15, 2)
  discount     Decimal  @default(0) @db.Decimal(15, 2)
  subtotal     Decimal  @db.Decimal(15, 2)
  created_at   DateTime @default(now()) @db.Timestamp(6)

  // Relations
  order Order @relation(fields: [order_id], references: [id])

  @@map("order_items")
}

model Target {
  id               String       @id @default(uuid()) @db.Uuid
  user_id          String       @db.Uuid
  period_type      TargetPeriod
  period_start     DateTime     @db.Date
  period_end       DateTime     @db.Date
  target_amount    Decimal      @db.Decimal(15, 2)
  target_visits    Int
  target_new_leads Int
  created_at       DateTime     @default(now()) @db.Timestamp(6)
  updated_at       DateTime     @updatedAt @db.Timestamp(6)

  // Relations
  user User @relation(fields: [user_id], references: [id])

  @@map("targets")
}
